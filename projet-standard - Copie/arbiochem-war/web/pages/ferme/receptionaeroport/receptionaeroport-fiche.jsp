<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ page import="affichage.PageConsulte" %><%@ page import="user.UserEJB" %><%@ page import="utilitaire.ConstanteEtat" %>
<%@ page import="ferme.receptionaeroport.ReceptionPoussinAeroportImportLib" %><%@ page import="faturefournisseur.As_BonDeCommandePoussinLib" %>
<% try{
    String lien=(String)session.getValue("lien");PageConsulte pc=new PageConsulte(new ReceptionPoussinAeroportImportLib(),request,(UserEJB)session.getValue("u"));pc.setTitre("Fiche de réception à l'aéroport");ReceptionPoussinAeroportImportLib b=(ReceptionPoussinAeroportImportLib)pc.getBase();String id=b.getId();
    As_BonDeCommandePoussinLib bc=(As_BonDeCommandePoussinLib)new As_BonDeCommandePoussinLib().getById(b.getIdBc(),"AS_BONDECOMMANDE_POUSSIN_LIB",null);
    String[] caches={"etat","idLot","idBc","heureDepart","nbrCartonMale","nbrCartonFemelle","nbVivantsMale","nbVivantsFemelle","dateDepartPrevue","dateDepartReelle","dateArriveePrevue","ecart"};for(String c:caches)if(pc.getChampByName(c)!=null)pc.getChampByName(c).setVisible(false);
    pc.getChampByName("numeroBon").setLibelle("N° commande");pc.getChampByName("fournisseurLib").setLibelle("Fournisseur");pc.getChampByName("idSoucheLib").setLibelle("Race");pc.getChampByName("ageJours").setLibelle("Âge (jours)");pc.getChampByName("nbMaleRequis").setLibelle("Mâles commandés");pc.getChampByName("nbFemelleRequis").setLibelle("Femelles commandées");pc.getChampByName("quantiteCommandee").setLibelle("Total commandé");pc.getChampByName("nbMorts").setLibelle("Morts à l'aéroport");pc.getChampByName("nbPerdus").setLibelle("Perdus à l'aéroport");pc.getChampByName("qteRecus").setLibelle("Vivants disponibles");pc.getChampByName("conformite").setLibelle("Contrôle");pc.getChampByName("etatLib").setLibelle("État");pc.getChampByName("daty").setLibelle("Date de réception");pc.getChampByName("heureArrive").setLibelle("Heure de réception");pc.getChampByName("remarque").setLibelle("Remarque");
    pc.setOrdre(new String[]{"numeroBon","fournisseurLib","idSoucheLib","ageJours","quantiteCommandee","nbMaleRequis","nbFemelleRequis","daty","heureArrive","nbMorts","nbPerdus","qteRecus","conformite","remarque","etatLib"});
%><div class="content-wrapper"><h1 class="box-title"><a href="<%=lien%>?but=ferme/receptionaeroport/receptionaeroport-liste.jsp"><i class="fa fa-angle-left"></i></a> <%=pc.getTitre()%></h1><div class="row m-0"><div class="col-md-12"><div class="box"><div class="box-body"><%out.println(pc.getHtml());%><div class="box-footer">
<%if(b.getEtat()<ConstanteEtat.getEtatValider()){%><a class="btn btn-primary pull-right" href="<%=lien%>?but=apresTarif.jsp&id=<%=id%>&acte=valider&bute=ferme/receptionaeroport/receptionaeroport-fiche.jsp&classe=ferme.receptionaeroport.ReceptionPoussinAeroport">Valider la réception</a><a class="btn btn-secondary pull-right" style="margin-right:10px" href="<%=lien%>?but=ferme/receptionaeroport/receptionaeroport-saisie.jsp&id=<%=id%>">Modifier</a><a class="btn btn-danger" href="<%=lien%>?but=apresTarif.jsp&id=<%=id%>&acte=delete&bute=ferme/receptionaeroport/receptionaeroport-liste.jsp&classe=ferme.receptionaeroport.ReceptionPoussinAeroport">Supprimer</a>
<%}else if(bc.getIdTransfertPoulet()==null||bc.getIdTransfertPoulet().isEmpty()){%><a class="btn btn-primary pull-right" href="<%=lien%>?but=ferme/transfertpoulet/transfertpoulet-saisie.jsp&idReceptionAeroport=<%=id%>">Organiser le transfert au poulailler</a>
<%}else{%><a class="btn btn-secondary pull-right" href="<%=lien%>?but=ferme/transfertpoulet/transfertpoulet-fiche.jsp&id=<%=bc.getIdTransfertPoulet()%>">Voir le transfert</a><%}%>
</div></div></div></div></div></div>
<%}catch(Exception e){e.printStackTrace();%><script>alert('<%=e.getMessage()%>');history.back();</script><%}%>
