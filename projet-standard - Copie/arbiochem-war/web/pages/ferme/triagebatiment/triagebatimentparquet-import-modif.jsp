<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ page import="affichage.*" %><%@ page import="user.UserEJB" %><%@ page import="bean.*" %>
<%@ page import="ferme.triageBatiment.*" %><%@ page import="ferme.transfertpoulet.TransfertPouletLib" %><%@ page import="ferme.configuration.CompartimentLib" %><%@ page import="ferme.utils.ConstanteFerme" %>
<%try{
    String id=request.getParameter("id");if(id==null||id.trim().isEmpty())throw new Exception("Triage manquant");TriageBatimentParquet triage=(TriageBatimentParquet)new TriageBatimentParquet().getById(id,"TRIAGEBATIMENTPARQUET",null);if(triage.getIdTransfertPoulet()==null||triage.getIdTransfertPoulet().isEmpty())throw new Exception("Ce triage n'appartient pas au parcours d'importation");
    TriageBatimentParquetDetail filtre=new TriageBatimentParquetDetail();filtre.setIdmere(id);TriageBatimentParquetDetail[] details=(TriageBatimentParquetDetail[])CGenUtil.rechercher(filtre,null,null," ORDER BY ID");TransfertPouletLib transfert=(TransfertPouletLib)new TransfertPouletLib().getById(triage.getIdTransfertPoulet(),"TRANSFERTPOULET_LIB",null);
    PageUpdateMultiple pi=new PageUpdateMultiple(new TriageBatimentParquet(),new TriageBatimentParquetDetail(),details,request,(UserEJB)session.getValue("u"),details.length);pi.setLien((String)session.getValue("lien"));
    pi.getFormu().getChamp("id").setVisible(false);pi.getFormu().getChamp("etat").setVisible(false);pi.getFormu().getChamp("idReceptionPoulailler").setVisible(false);pi.getFormu().getChamp("idTransfertPoulet").setVisible(false);pi.getFormu().getChamp("daty").setLibelle("Date du triage");pi.getFormu().getChamp("idlot").setLibelle("Lot d'élevage");pi.getFormu().getChamp("idlot").setAutre("readonly");pi.getFormu().getChamp("dispomale").setLibelle("Mâles vivants après triage");pi.getFormu().getChamp("dispofemelle").setLibelle("Femelles vivantes après triage");
    Champ.setVisible(pi.getFormufle().getChampFille("id"),false);Champ.setVisible(pi.getFormufle().getChampFille("idmere"),false);Champ.setVisible(pi.getFormufle().getChampFille("idbatiment"),false);Champ.setVisible(pi.getFormufle().getChampFille("idparquet"),false);Champ.setVisible(pi.getFormufle().getChampFille("idqualite"),false);
    Liste[] listes=new Liste[2];CompartimentLib compartiment=new CompartimentLib();listes[0]=new Liste("idCompartiment",compartiment,"libelle","id");String destination=transfert.getIdMagasin()==null?"":transfert.getIdMagasin().replace("'","''");listes[0].setApresW(" and actif=1 and idmere in (select id from batiment where idferme='"+destination+"')");TypeObjet sexe=new TypeObjet();sexe.setNomTable("SEXE");listes[1]=new Liste("idsexe",sexe,"val","id");pi.getFormufle().changerEnChamp(listes);
    pi.getFormufle().getChamp("idCompartiment_0").setLibelle("Compartiment");pi.getFormufle().getChamp("idsexe_0").setLibelle("Sexe");pi.getFormufle().getChamp("qte_0").setLibelle("Nombre de poussins");pi.getFormufle().getChamp("sante_0").setLibelle("Santé (1 à 10)");pi.getFormufle().getChamp("remarque_0").setLibelle("Remarque");for(int i=0;i<details.length;i++){pi.getFormufle().getChamp("qte_"+i).setAutre("min='1' step='1'");pi.getFormufle().getChamp("sante_"+i).setAutre("min='1' max='10' step='1'");}pi.getFormufle().setColOrdre(new String[]{"idCompartiment","idsexe","qte","sante","remarque"});pi.preparerDataFormu();pi.getFormu().makeHtmlInsertTabIndex();pi.getFormufle().makeHtmlInsertTableauIndex();
%><div class="content-wrapper"><h1>Modifier le triage et les affectations</h1><div class="container"><p>Commande <strong><%=transfert.getNumeroBon()%></strong> — <strong><%=transfert.getNbVivants()%></strong> survivants à répartir.</p></div><form class="container" action="<%=pi.getLien()%>?but=apresMultiple.jsp&id=<%=id%>" method="post"><%out.println(pi.getFormu().getHtmlInsert());out.println(pi.getFormufle().getHtmlTableauInsert());%><input type="hidden" name="acte" value="updateInsert"><input type="hidden" name="bute" value="ferme/triagebatiment/triagebatimentparquet-fiche.jsp"><input type="hidden" name="classe" value="ferme.triageBatiment.TriageBatimentParquet"><input type="hidden" name="classefille" value="ferme.triageBatiment.TriageBatimentParquetDetail"><input type="hidden" name="nomtable" value="TRIAGEBATIMENTPARQUETDETAIL"><input type="hidden" name="nombreLigne" value="<%=pi.getNombreLigne()%>"><input type="hidden" name="colonneMere" value="idmere"></form></div>
<%}catch(Exception e){e.printStackTrace();%><script>alert('<%=e.getMessage()%>');history.back();</script><%}%>
