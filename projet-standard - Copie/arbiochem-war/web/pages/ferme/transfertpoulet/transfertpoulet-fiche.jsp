<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ page import="affichage.PageConsulte" %><%@ page import="user.UserEJB" %><%@ page import="utilitaire.ConstanteEtat" %><%@ page import="bean.CGenUtil" %>
<%@ page import="ferme.transfertpoulet.TransfertPouletLib" %><%@ page import="ferme.triageBatiment.TriageBatimentParquet" %>
<%try{String lien=(String)session.getValue("lien");PageConsulte pc=new PageConsulte(new TransfertPouletLib(),request,(UserEJB)session.getValue("u"));pc.setTitre("Fiche du transfert vers le poulailler");TransfertPouletLib b=(TransfertPouletLib)pc.getBase();String id=b.getId();boolean importation=b.getIdReceptionAeroport()!=null&&!b.getIdReceptionAeroport().trim().isEmpty();TriageBatimentParquet filtre=new TriageBatimentParquet();filtre.setIdTransfertPoulet(id);TriageBatimentParquet[] triages=(TriageBatimentParquet[])CGenUtil.rechercher(filtre,null,null,"");String idTriage=triages.length==0?null:triages[0].getId();
String[] caches=importation?new String[]{"etat","idLot","idLotLib","idReceptionAeroport","idMagasin","quantiteCommandee"}:new String[]{"etat","idLot","idReceptionAeroport","numeroBon","fournisseurLib","idMagasin","idMagasinLib","ageJours","dateReceptionAeroport","heureReceptionAeroport","nbMortsAeroport","nbPerdusAeroport","nbVivantsAeroport","quantiteCommandee","heureArrive","idVehicule","idChauffeur","idControleur","nbMorts","nbPerdus","nbVivants"};for(String c:caches)if(pc.getChampByName(c)!=null)pc.getChampByName(c).setVisible(false);
pc.getChampByName("id").setLibelle("N° transfert");pc.getChampByName("idLotLib").setLibelle("Lot");pc.getChampByName("numeroBon").setLibelle("N° commande");pc.getChampByName("fournisseurLib").setLibelle("Fournisseur");pc.getChampByName("idsouchelib").setLibelle("Race");pc.getChampByName("ageJours").setLibelle("Âge (jours)");pc.getChampByName("idMagasinLib").setLibelle("Poulailler");pc.getChampByName("dateReceptionAeroport").setLibelle("Date de réception aéroport");pc.getChampByName("heureReceptionAeroport").setLibelle("Heure de réception aéroport");pc.getChampByName("nbMortsAeroport").setLibelle("Morts à l'aéroport");pc.getChampByName("nbPerdusAeroport").setLibelle("Perdus à l'aéroport");pc.getChampByName("nbVivantsAeroport").setLibelle("Vivants au départ");pc.getChampByName("daty").setLibelle(importation?"Arrivée au poulailler":"Date du transfert");pc.getChampByName("heureArrive").setLibelle("Heure d'arrivée");pc.getChampByName("idVehicule").setLibelle("Véhicule");pc.getChampByName("idChauffeur").setLibelle("Chauffeur");pc.getChampByName("idControleur").setLibelle("Contrôleur");pc.getChampByName("nbMorts").setLibelle("Morts durant le trajet");pc.getChampByName("nbPerdus").setLibelle("Perdus durant le trajet");pc.getChampByName("nbVivants").setLibelle("Survivants à trier");pc.getChampByName("remarque").setLibelle("Remarque");pc.getChampByName("etatLib").setLibelle("État");
pc.setOrdre(importation?new String[]{"numeroBon","fournisseurLib","idsouchelib","ageJours","idMagasinLib","dateReceptionAeroport","heureReceptionAeroport","nbMortsAeroport","nbPerdusAeroport","nbVivantsAeroport","daty","heureArrive","idVehicule","idChauffeur","idControleur","nbMorts","nbPerdus","nbVivants","remarque","etatLib"}:new String[]{"idLotLib","idsouchelib","daty","remarque","etatLib"});%>
<div class="content-wrapper"><h1 class="box-title"><a href="<%=lien%>?but=ferme/transfertpoulet/transfertpoulet-liste.jsp"><i class="fa fa-angle-left"></i></a> <%=pc.getTitre()%> N° <%=id%></h1><div class="row m-0"><div class="col-md-12"><div class="box"><div class="box-body"><%out.println(pc.getHtml());%><div class="box-footer">
<%if(b.getEtat()<ConstanteEtat.getEtatValider()){%><a class="btn btn-primary pull-right" href="<%=lien%>?but=apresTarif.jsp&id=<%=id%>&acte=valider&bute=ferme/transfertpoulet/transfertpoulet-fiche.jsp&classe=ferme.transfertpoulet.TransfertPoulet">Valider l'arrivée</a><a class="btn btn-secondary pull-right" style="margin-right:10px" href="<%=lien%>?but=ferme/transfertpoulet/transfertpoulet-saisie.jsp&id=<%=id%>">Modifier</a><a class="btn btn-danger" href="<%=lien%>?but=apresTarif.jsp&id=<%=id%>&acte=delete&bute=ferme/transfertpoulet/transfertpoulet-liste.jsp&classe=ferme.transfertpoulet.TransfertPoulet">Supprimer</a>
<%}else if(importation&&idTriage==null){%><a class="btn btn-primary pull-right" href="<%=lien%>?but=ferme/triagebatiment/triagebatimentparquet-import-saisie.jsp&idTransfertPoulet=<%=id%>">Trier et affecter les poussins</a>
<%}else if(importation){%><a class="btn btn-secondary pull-right" href="<%=lien%>?but=ferme/triagebatiment/triagebatimentparquet-fiche.jsp&id=<%=idTriage%>">Voir le triage</a><%}%>
</div></div></div></div></div></div>
<%}catch(Exception e){e.printStackTrace();%><script>alert('<%=e.getMessage()%>');history.back();</script><%}%>
