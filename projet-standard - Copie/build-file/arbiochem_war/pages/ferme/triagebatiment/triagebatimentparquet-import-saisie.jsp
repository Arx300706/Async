<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ page import="affichage.*" %><%@ page import="user.UserEJB" %><%@ page import="bean.TypeObjet" %>
<%@ page import="ferme.triageBatiment.*" %><%@ page import="ferme.transfertpoulet.TransfertPouletLib" %>
<%@ page import="ferme.configuration.CompartimentLib" %><%@ page import="ferme.utils.ConstanteFerme" %>
<%try{
    UserEJB u=(UserEJB)session.getValue("u");String idTransfert=request.getParameter("idTransfertPoulet");if(idTransfert==null||idTransfert.trim().isEmpty())throw new Exception("Transfert de poulets manquant");
    TransfertPouletLib transfert=(TransfertPouletLib)new TransfertPouletLib().getById(idTransfert,"TRANSFERTPOULET_LIB",null);int n=10;
    PageInsertMultiple pi=new PageInsertMultiple(new TriageBatimentParquet(),new TriageBatimentParquetDetail(),request,n,u);String lien=(String)session.getValue("lien");if(lien==null||lien.trim().isEmpty()){lien="module.jsp";session.setAttribute("lien",lien);}pi.setLien(lien);
    pi.getFormu().getChamp("etat").setVisible(false);pi.getFormu().getChamp("idReceptionPoulailler").setVisible(false);pi.getFormu().getChamp("idTransfertPoulet").setVisible(false);pi.getFormu().getChamp("idTransfertPoulet").setDefaut(idTransfert);
    pi.getFormu().getChamp("daty").setLibelle("Date du triage");pi.getFormu().getChamp("daty").setDefaut(utilitaire.Utilitaire.dateDuJour());pi.getFormu().getChamp("idlot").setLibelle("Lot d'élevage");String destinationLot=transfert.getIdMagasin()==null?"":transfert.getIdMagasin().replace("'","''");String lotWhere=" AND idferme='"+destinationLot+"'";pi.getFormu().getChamp("idlot").setPageAppelCompleteAWhere("ferme.lot.LotTransfertDisponible","id","LOT_TRANSFERT_DISPONIBLE_LIB","id;capacite","idlot;capaciteLot",lotWhere);pi.getFormu().getChamp("idlot").setPageAppelInsert("ferme/lot/lot-saisie.jsp","idlot;idlotlibelle","id;nomlot");
    pi.getFormu().getChamp("dispomale").setLibelle("Mâles vivants après triage");pi.getFormu().getChamp("dispofemelle").setLibelle("Femelles vivantes après triage");pi.getFormu().getChamp("dispomale").setDefaut("0");pi.getFormu().getChamp("dispofemelle").setDefaut("0");pi.getFormu().getChamp("dispomale").setAutre("min='0' step='1'");pi.getFormu().getChamp("dispofemelle").setAutre("min='0' step='1'");
    Champ.setVisible(pi.getFormufle().getChampFille("id"),false);Champ.setVisible(pi.getFormufle().getChampFille("idmere"),false);Champ.setVisible(pi.getFormufle().getChampFille("idbatiment"),false);Champ.setVisible(pi.getFormufle().getChampFille("idparquet"),false);Champ.setVisible(pi.getFormufle().getChampFille("idqualite"),false);
    Liste[] listes=new Liste[2];CompartimentLib compartiment=new CompartimentLib();listes[0]=new Liste("idCompartiment",compartiment,"libelle","id");String destination=transfert.getIdMagasin()==null?"":transfert.getIdMagasin().replace("'","''");listes[0].setApresW(" and actif=1 and idmere in (select id from batiment where idferme='"+destination+"')");TypeObjet sexe=new TypeObjet();sexe.setNomTable("SEXE");listes[1]=new Liste("idsexe",sexe,"val","id");pi.getFormufle().changerEnChamp(listes);
    pi.getFormufle().getChamp("idCompartiment_0").setLibelle("Compartiment");pi.getFormufle().getChamp("idsexe_0").setLibelle("Sexe");pi.getFormufle().getChamp("qte_0").setLibelle("Nombre de poussins");pi.getFormufle().getChamp("sante_0").setLibelle("Santé (1 à 10)");pi.getFormufle().getChamp("remarque_0").setLibelle("Remarque");
    for(int i=0;i<n;i++){pi.getFormufle().getChamp("idqualite_"+i).setDefaut(ConstanteFerme.qualiteConforme);pi.getFormufle().getChamp("qte_"+i).setAutre("min='1' step='1'");pi.getFormufle().getChamp("sante_"+i).setDefaut("10");pi.getFormufle().getChamp("sante_"+i).setAutre("min='1' max='10' step='1'");}
    pi.getFormufle().setColOrdre(new String[]{"idCompartiment","idsexe","qte","sante","remarque"});pi.preparerDataFormu();pi.getFormu().makeHtmlInsertTabIndex();pi.getFormufle().makeHtmlInsertTableauIndex();
%><div class="content-wrapper"><h1>Triage et affectation aux bâtiments/parquets</h1><div class="container"><p>Commande <strong><%=transfert.getNumeroBon()%></strong> — race <strong><%=transfert.getIdsouchelib()%></strong> — poulailler <strong><%=transfert.getIdMagasinLib()%></strong>.</p><p>À répartir : <strong><%=transfert.getNbVivants()%></strong> survivants après le transfert. Comptage saisi : <strong><span id="totalSexes">0</span></strong>. Affectés aux compartiments : <strong><span id="totalAffecte">0</span></strong>.</p></div>
<form class="container" action="<%=pi.getLien()%>?but=apresMultiple.jsp" method="post"><%out.println(pi.getFormu().getHtmlInsert());out.println(pi.getFormufle().getHtmlTableauInsert());%><input type="hidden" name="acte" value="insert"><input type="hidden" name="bute" value="ferme/triagebatiment/triagebatimentparquet-fiche.jsp"><input type="hidden" name="classe" value="ferme.triageBatiment.TriageBatimentParquet"><input type="hidden" name="classefille" value="ferme.triageBatiment.TriageBatimentParquetDetail"><input type="hidden" name="nomtable" value="TRIAGEBATIMENTPARQUETDETAIL"><input type="hidden" name="nombreLigne" value="<%=n%>"><input type="hidden" name="colonneMere" value="idmere"></form></div>
<script>(function(){function n(id){var e=document.getElementById(id);return e?parseInt(e.value,10)||0:0;}function total(){document.getElementById("totalSexes").textContent=n("dispomale")+n("dispofemelle");var a=0;for(var i=0;i<<%=n%>;i++)a+=n("qte_"+i);document.getElementById("totalAffecte").textContent=a;}document.addEventListener("input",function(e){if(e.target&&(/^(dispomale|dispofemelle|qte_\d+)$/.test(e.target.id)))total();});total();})();</script><script>$(function(){var lotInput=$("#idlotlibelle");if(lotInput.length&&lotInput.autocomplete("instance")){lotInput.autocomplete("option","minLength",0);lotInput.off("focus.lotDisponible").on("focus.lotDisponible",function(){if(!$(this).val())$("#idlotsearchBtn").trigger("click");});}});</script>
<%}catch(Exception e){e.printStackTrace();String m=e.getMessage()==null?"Impossible d'afficher le triage":e.getMessage().replace("'","\\'").replace("\n"," ");%><script>alert('<%=m%>');history.back();</script><%}%>
