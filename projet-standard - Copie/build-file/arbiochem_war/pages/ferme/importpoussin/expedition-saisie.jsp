<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ page import="faturefournisseur.As_BonDeCommandePoussinLib" %><%@ page import="user.UserEJB" %>
<% try { String id=request.getParameter("id"); As_BonDeCommandePoussinLib b=(As_BonDeCommandePoussinLib)new As_BonDeCommandePoussinLib().getById(id,"AS_BONDECOMMANDE_POUSSIN_LIB",null); %>
<div class="content-wrapper"><h1>Confirmation d'envoi fournisseur</h1><form class="container" action="<%=(String)session.getValue("lien")%>?but=ferme/importpoussin/apres-expedition.jsp" method="post"><p>Bon <strong><%=b.getId()%></strong> — fournisseur <strong><%=b.getFournisseurLib()%></strong> — race <strong><%=b.getIdSoucheLib()%></strong> — <strong><%=b.getNbMaleRequis()%> mâles</strong> et <strong><%=b.getNbFemelleRequis()%> femelles</strong> — montant <strong><%=b.getMontant()%></strong>.</p><label>Date réelle de départ</label><input class="form-control" type="date" name="dateDepartReelle" value="<%=java.time.LocalDate.now()%>" required><input type="hidden" name="id" value="<%=id%>"><br><button class="btn btn-primary" type="submit">Le fournisseur a envoyé la commande</button></form></div>
<% } catch(Exception e){e.printStackTrace();%><script>alert('<%=e.getMessage()%>');history.back();</script><% } %>
