<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ page import="affichage.*" %><%@ page import="user.UserEJB" %><%@ page import="ferme.transfertpoulet.*" %><%@ page import="ferme.receptionaeroport.ReceptionPoussinAeroportImportLib" %>
<% try{
    UserEJB u=(UserEJB)session.getValue("u");String id=request.getParameter("id"),idReception=request.getParameter("idReceptionAeroport");TransfertPoulet existant=null;
    if(id!=null&&!id.trim().isEmpty()){existant=(TransfertPoulet)new TransfertPoulet().getById(id,"TRANSFERTPOULET",null);idReception=existant.getIdReceptionAeroport();}
    if(idReception==null||idReception.trim().isEmpty())throw new Exception("Choisissez une réception aéroport validée");
    ReceptionPoussinAeroportImportLib reception=(ReceptionPoussinAeroportImportLib)new ReceptionPoussinAeroportImportLib().getById(idReception,"RPA_IMPORT_LIB",null);
    PageInsert pi=existant==null?new PageInsert(new TransfertPoulet(),request):new PageUpdate(new TransfertPoulet(),request,u);String lien=(String)session.getValue("lien");if(lien==null||lien.trim().isEmpty()){lien="module.jsp";session.setAttribute("lien",lien);}pi.setLien(lien);
    if(pi.getFormu().getChamp("id")!=null)pi.getFormu().getChamp("id").setVisible(false);pi.getFormu().getChamp("etat").setVisible(false);pi.getFormu().getChamp("idLot").setVisible(false);pi.getFormu().getChamp("idReceptionAeroport").setVisible(false);pi.getFormu().getChamp("idReceptionAeroport").setDefaut(idReception);
    pi.getFormu().getChamp("daty").setLibelle("Date d'arrivée au poulailler");pi.getFormu().getChamp("heureArrive").setLibelle("Heure d'arrivée");pi.getFormu().getChamp("heureArrive").setType("time");pi.getFormu().getChamp("nbMorts").setLibelle("Morts durant le trajet");pi.getFormu().getChamp("nbPerdus").setLibelle("Perdus durant le trajet");pi.getFormu().getChamp("nbVivants").setLibelle("Vivants après le transfert (calculé)");pi.getFormu().getChamp("nbVivants").setAutre("readonly");pi.getFormu().getChamp("idVehicule").setLibelle("Véhicule");pi.getFormu().getChamp("idChauffeur").setLibelle("Chauffeur");pi.getFormu().getChamp("idControleur").setLibelle("Contrôleur");pi.getFormu().getChamp("remarque").setLibelle("Remarque");
    pi.getFormu().getChamp("idVehicule").setPageAppelComplete("ferme.configuration.Vehicule","id","VEHICULE");pi.getFormu().getChamp("idChauffeur").setPageAppelComplete("paie.log.LogPersonnel","id","LOG_PERSONNEL");pi.getFormu().getChamp("idControleur").setPageAppelComplete("paie.log.LogPersonnel","id","LOG_PERSONNEL");
    if(existant==null){pi.getFormu().getChamp("daty").setDefaut(utilitaire.Utilitaire.dateDuJour());pi.getFormu().getChamp("heureArrive").setDefaut(java.time.LocalTime.now().format(java.time.format.DateTimeFormatter.ofPattern("HH:mm")));pi.getFormu().getChamp("nbMorts").setDefaut("0");pi.getFormu().getChamp("nbPerdus").setDefaut("0");}
    pi.preparerDataFormu();pi.getFormu().makeHtmlInsertTabIndex();String acte=existant==null?"insert":"update";
%><div class="content-wrapper"><h1>Transfert des poussins vers le poulailler</h1><div class="container"><p>Commande <strong><%=reception.getNumeroBon()%></strong> — race <strong><%=reception.getIdSoucheLib()%></strong> — réception aéroport <strong><%=reception.getId()%></strong>.</p><p>Disponibles au départ : <strong><%=reception.getQteRecus()%></strong> vivants après <%=reception.getNbMorts()%> mort(s) et <%=reception.getNbPerdus()%> perdu(s) à l'aéroport.</p></div>
<form class="container" action="<%=pi.getLien()%>?but=apresTarif.jsp<%=existant==null?"":"&id="+id%>" method="post"><%out.println(pi.getFormu().getHtmlInsert());%><input type="hidden" name="acte" value="<%=acte%>"><input type="hidden" name="bute" value="ferme/transfertpoulet/transfertpoulet-fiche.jsp"><input type="hidden" name="classe" value="ferme.transfertpoulet.TransfertPoulet"><input type="hidden" name="nomtable" value="TRANSFERTPOULET"></form></div>
<script>(function(){var total=<%=reception.getQteRecus()%>;function compter(){var morts=parseInt(document.getElementById('nbMorts').value,10)||0,perdus=parseInt(document.getElementById('nbPerdus').value,10)||0;document.getElementById('nbVivants').value=Math.max(0,total-Math.max(0,morts)-Math.max(0,perdus));}['nbMorts','nbPerdus'].forEach(function(id){var e=document.getElementById(id);if(e)e.addEventListener('input',compter);});compter();})();</script>
<%}catch(Exception e){e.printStackTrace();String m=e.getMessage()==null?"Impossible d'afficher le transfert":e.getMessage().replace("'","\\'").replace("\n"," ");%><script>alert('<%=m%>');history.back();</script><%}%>
